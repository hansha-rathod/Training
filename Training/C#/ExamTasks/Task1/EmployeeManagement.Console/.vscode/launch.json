{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Employee Management Console",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net472/EmployeeManagement.Console.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
